# Dad, Still Here - Production Environment Variables
# Copy to .env.local on your VPS server
# KEEP THIS FILE SECURE - Don't commit to git!

# ===== DATABASE =====
DATABASE_URL="postgresql://dadstillhere_user:YOUR_DB_PASSWORD@localhost:5432/dadstillhere_db"

# ===== NEXTAUTH =====
NEXTAUTH_URL="https://dadstillhere.com"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"

# ===== EMAIL SERVICE =====
# Using Gmail SMTP
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-gmail-app-password"
EMAIL_FROM="noreply@dadstillhere.com"

# Alternative: SendGrid
# EMAIL_SERVER_HOST="smtp.sendgrid.net"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="apikey"
# EMAIL_SERVER_PASSWORD="SG.your-sendgrid-api-key"

# ===== AWS S3 STORAGE (Optional) =====
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="dadstillhere-media"

# ===== ANALYTICS & TRACKING =====
NEXT_PUBLIC_ANALYTICS_ID="your-google-analytics-id"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"

# ===== FACEBOOK & META =====
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="1534484327973771"
FACEBOOK_CONVERSIONS_API_TOKEN="your-conversions-api-token"

# ===== HUBSPOT CRM =====
HUBSPOT_API_KEY="your-hubspot-private-app-token"
HUBSPOT_PORTAL_ID="247128708"

# ===== ENVIRONMENT =====
NODE_ENV="production"
NEXT_PUBLIC_API_URL="https://dadstillhere.com/api"

# ===== ENCRYPTION =====
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-encryption-key-for-journal-entries"

# ===== RATE LIMITING =====
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# ===== ADMIN =====
ADMIN_EMAIL="admin@dadstillhere.com"

# ===== OPENAI (Optional - for moderation AI) =====
# OPENAI_API_KEY="sk-your-openai-api-key"
