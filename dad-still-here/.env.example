# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dadstillhere"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Email Service (for newsletters and notifications)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@dadstillhere.com"

# AWS S3 for media storage (optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="dadstillhere-media"

# Analytics
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Environment
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Moderation AI (optional - for auto-detection)
OPENAI_API_KEY="your-openai-key"

# Privacy & Security
ENCRYPTION_KEY="your-encryption-key-for-journal"
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Admin
ADMIN_EMAIL="admin@dadstillhere.com"

# Facebook & Meta Integration
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="1534484327973771"
FACEBOOK_PIXEL_ID="1534484327973771"
FACEBOOK_CONVERSIONS_API_TOKEN="your-conversions-api-token"

# HubSpot CRM Integration
HUBSPOT_API_KEY="your-hubspot-private-app-token"
HUBSPOT_PORTAL_ID="247128708"
