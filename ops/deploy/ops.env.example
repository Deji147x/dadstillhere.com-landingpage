# /etc/dsh/ops.env — ops settings (chmod 600). Not social credentials; those stay in social.env.
# Dead-man's switch: healthchecks.io → Settings → Ping key. Each job auto-creates its check.
HC_PING_KEY=
# Phone push alerts: install the ntfy app, subscribe to this topic. Make it long and unguessable.
NTFY_TOPIC=dsh-alerts-CHANGE-ME-7f3k9q
# Offsite: an rclone remote (Cloudflare R2 or Backblaze B2, both free at this size). `rclone config` first.
RCLONE_REMOTE=offsite:dsh-backups
# Encrypts every offsite archive. Keep a copy in your password manager — without it, backups are unreadable.
BACKUP_PASSPHRASE=
# Warn when fewer than this many future entries are queued.
RUNWAY_WARN_DAYS=10
